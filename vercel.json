{
  "rewrites": [
    {
      "source": "/arti",
      "destination": "https://neuralfin-arti.vercel.app/"
    },
    {
      "source": "/arti/:path*",
      "destination": "https://neuralfin-arti.vercel.app/:path*"
    },
    {
      "source": "/lubuds",
      "destination": "/lubuds.html"
    },
    {
      "source": "/hksi",
      "destination": "/hksi/notes.html"
    },
    {
      "source": "/hksi/",
      "destination": "/hksi/notes.html"
    },
    {
      "source": "/notes.js",
      "destination": "/hksi/notes.js"
    }
  ]
}
